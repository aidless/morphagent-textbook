# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{tex,bib,sty,cls}]
indent_size = 2

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{js,jsx,ts,tsx,mjs,cjs,json,css,html,sql}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
